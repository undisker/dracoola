# =============================================================================
# Dracoola Imaging Library - Git Ignore File
# FreePascal/Lazarus Project
# =============================================================================

# =============================================================================
# Build Output Directories
# =============================================================================

# Binary output directories
Bin/
Demos/Bin/
Extras/Bin/

# Unit output directories (compiled units)
lib/
units/

# Package output
Packages/lib/

# =============================================================================
# FreePascal Compiler Output
# =============================================================================

# Compiled units
*.ppu
*.o
*.or
*.res
*.rsj
*.rst
*.rsm

# Compiled package units
*.ppl
*.pcp

# Debug information
*.dbg

# Smart linking files
*.lrs

# FPC link files
*.lfm.bak
link*.res
ppas.bat
ppas.sh

# FPC generated assembler
*.s

# =============================================================================
# Lazarus IDE Files
# =============================================================================

# Session files (user-specific, not needed in repo)
*.lps

# Compiled resource
*.compiled

# Backup files
backup/
**/backup/

# Editor session
*.lpr.rst
*.lpr.rsj

# =============================================================================
# Delphi Files (legacy, should not exist but just in case)
# =============================================================================

# Compiled units
*.dcu
*.dpu
*.dcpil

# Project files we don't want
*.dproj
*.dsk
*.identcache
*.local
*.stat
*.tvsconfig
*.deployproj

# Delphi config
*.cfg

# History/recovery (Delphi IDE)
__history/
__recovery/

# =============================================================================
# Executables and Libraries
# =============================================================================

# Windows executables
*.exe
*.dll
*.ocx
*.scr

# Linux/Unix executables and libraries
*.so
*.so.*

# macOS executables and libraries
*.dylib
*.app
*.dSYM/

# Static libraries (general)
*.lib

# Note: *.a files are NOT globally ignored because Extensions/J2KObjects and
# Extensions/LibTiff/Compiled contain pre-compiled static libraries that are
# intentionally included for convenience

# =============================================================================
# Documentation Build Output
# =============================================================================

Doc/_Dox/
Doc/_HTMLHelp/
Doc/html/
Doc/chm/
Doc/RefDoc/
Doc/_final/
Doc/*.chm
Doc/*.chw
Doc/*.html

# =============================================================================
# Test and Internal Directories
# =============================================================================

__internal/
Tests/
Extras/TestCases/
Demos/Bin/_BenchOut/
Scripts/_*

# =============================================================================
# C/C++ Header Output (generated by Delphi)
# =============================================================================

Source/**/*.hpp
Extensions/**/*.hpp

# =============================================================================
# IDE and Editor Temporary Files
# =============================================================================

# Backup files
*.bak
*.~*
*.*~
*.orig
*.swp
*~

# Tag files
*.tgs
*.tgw

# Visual Studio (if used for C bindings)
*.suo
*.user
*.vcxproj.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# JetBrains IDEs
.idea/

# VS Code
.vscode/

# =============================================================================
# macOS System Files
# =============================================================================

.DS_Store
.AppleDouble
.LSOverride
._*

# =============================================================================
# Windows System Files
# =============================================================================

Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# Linux System Files
# =============================================================================

*~
.directory

# =============================================================================
# Temporary and Log Files
# =============================================================================

*.log
*.tmp
*.temp
*.cache

# =============================================================================
# Package Manager Directories (if using any)
# =============================================================================

node_modules/
vendor/

# =============================================================================
# Project-Specific Exclusions
# =============================================================================

# Generated icons in demos (keep source, exclude generated)
Demos/**/ImgBrowser.ico
Demos/**/lclimager.ico

# Keep resource files that are part of source
!Demos/ObjectPascal/LCLImager/*.res
!Demos/ObjectPascal/ImageBrowser/*.res

# Removed demos (were Delphi-only or Windows-only)
Demos/ObjectPascal/FireMonkeyDemo/
Demos/ObjectPascal/D3DDemo/

# =============================================================================
# External Libraries Source (downloaded/cloned, not committed)
# =============================================================================

# Dependencies folder contains cloned external library sources
# These are built locally and binaries placed in libs/
dependencies/

# =============================================================================
# Pre-built External Library Binaries (INCLUDED in git)
# =============================================================================

# Note: libs/ folder contains pre-built binaries for external libraries
# These ARE committed to git so users don't need to build them
# Subfolders: win64/, macos-arm64/, macos-x64/, linux-x64/
# Do NOT ignore libs/ - we want these in the repository

# =============================================================================
# End of .gitignore
# =============================================================================
