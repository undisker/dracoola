<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="DracoolaImagingPackage"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Dracoola Imaging Library (Fork of Vampyre Imaging Library)"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../Source;../Source/JpegTurbo;../Source/ZLib"/>
        <OtherUnitFiles Value="../Source;../Source/JpegTurbo;../Source/ZLib"/>
        <UnitOutputDirectory Value="../Bin/$(TargetCPU)-$(TargetOS)/pkg"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <IncludeAssertionCode Value="True"/>
        </SyntaxOptions>
      </Parsing>
      <CodeGeneration>
        <Optimizations>
          <OptimizationLevel Value="3"/>
          <VariablesInRegisters Value="True"/>
        </Optimizations>
      </CodeGeneration>
      <Other>
        <Verbosity>
          <ShowNotes Value="False"/>
          <ShowHints Value="False"/>
        </Verbosity>
        <CustomOptions Value="-dDONT_LINK_EXTRAS"/>
        <OtherDefines Count="1">
          <Define0 Value="DONT_LINK_EXTRAS"/>
        </OtherDefines>
      </Other>
    </CompilerOptions>
    <Description Value="Dracoola Imaging Library Package for Lazarus. High-performance FreePascal-only image loading, saving, and manipulation library with SIMD acceleration."/>
    <License Value="MPL 2.0 (GPL compatible)"/>
    <Version Major="1" Minor="0"/>
    <Files Count="24">
